          #BASIC QUERIES#

1] Display all the patient details
SELECT * FROM patients;
4]show the patient full name
select first_name || ' ' || last_name as patient_name from patients;
3]list all the male patients
select * from patients 
where gender = 'Male';
4]display patients from a pune city
select* from patients
where city = 'Pune';
5]show all doctors
select* from doctors;
6]display doctors full_name with speciality
select first_name || ' ' ||last_name as doctors_name ,speciality from doctors;
7]show all admissions
select* from admissions;
8]count total patients
select count(*) as total_patients from patients;
9]list distinct diagnosis 
select distinct diagnosis from admissions;
10]show all the province name
select* from province_names;

         #INTERMEDIATE QUERIES#

1]patient name with province name
select p.first_name,p.last_name,pr.province_name 
from patients p
join province_names pr
on p.province_id = pr.province_id;
2]admission details with patient_name
select a.admission_id,p.first_name,p.last_name,a.diagnosis
from admissions a
join patients p
on a.patient_id = p.patient_id;
3]show the admisssions with doctor name
select a.admission_id,d.first_name || ' ' || d.last_name as doctor_name from admissions a
join doctors d
on a.attending_doctor_id = d.doctor_id;
4]count patients per province
select pr.province_name , count(*) as patient_count
from patients p
join province_names pr
on p.province_id = pr.province_id
group by pr.province_name;
5]show the patient with allergies
select first_name ,last_name,allergies
from patients
where allergies is not null;
6]calculate the patient age
select first_name ,
            floor(months_between(sysdate,birth_date)/12) as age 
            from patients;
7]show the number od admissions per patients
select patient_id ,count(*) as total_admissions
from admissions
group by patient_id;  
8]the patient admitted more than once
select patient_id from admissions
group by patient_id
having count(*)>=1;
9]average height and weight by gender
select gender,
             avg(height) as avg_height,
             avg(weight) as avg_weight 
from patients
group by gender;
10]find the maximum and minimum patient height
select max(height) as max_height,
min(height) as min_height from patients;

        #ADVANCED QUERIES#

1]Rank patients by weight
select first_name,last_name,weight,rank() over (order by weight desc) as weight_rank from patients;
2]find patients with above-average weight
select * from patients
where weight > (select avg(weight) from patients);
3]find the most common dignosis
select diagnosis
from admissions
group by diagnosis
having count(*) = (
         select max(count(*))
         from admissions
         group by diagnosis);    
4]get the latest admissions for each parient
select * from (
               select a.*,row_number() over (partition by patient_id order by admission_date desc)
               as rn from admissions a)
               where rn =1;
5]calculate length of stay for each admission
select admission_id,patient_id,
discharge_date - admission_date as stay_days from admissions;
6]show cumultive admissions by date
select admission_date,count(*) over(order by admission_date)as
cumulative_admissions
from admissions;
7]identify repeat patient (admitted more than once)
select patient_id
from admissions
group by patient_id
having count(*)>=1;
8]each doctors busiest admission day
select attending_doctor_id ,admission_date from (
                select attending_doctor_id,admission_date,rank()over(partition by attending_doctor_id order by count(*)desc)as rnk from admissions 
                group by attending_doctor_id,admission_date)
                where rnk =1;
select* from admissions;

