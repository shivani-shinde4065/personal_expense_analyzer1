4]procedure to count admission for a patient
create or replace procedure
get_admission_count(p_id number )IS 
v_count number;
begin 
  select count(*) into v_count
  from admissions
  where patient_id = p_id;
  dbms_output.put_line ('admissions: ' || v_count );
end ;
/
5]function to calculate hospital stay days
create or replace function 
stay_days(p_adm_id number)
return number is
  v_days number;
begin 
 select discharge_date - admission_date 
 into v_days 
 from admissions
 where admission_id = p_adm_id;
 return v_days;
end;
/
